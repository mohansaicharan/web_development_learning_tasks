<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Learning Platform</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f7fc;
            color: #222;
        }

        header {
            background-color: #253b80;
            color: white;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        header h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
            font-size: 16px;
        }

        nav a:hover {
            color: #ffd166;
        }

        .hero {
            background: linear-gradient(120deg, #253b80, #5375d5);
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        .hero h2 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .hero a {
            display: inline-block;
            background-color: #ffd166;
            color: #222;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 40px auto;
        }

        .section-title {
            font-size: 28px;
            margin-bottom: 25px;
            color: #253b80;
        }

        .categories {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 40px;
        }

        .category {
            background-color: white;
            padding: 18px 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
            flex: 1 1 150px;
            text-align: center;
            font-weight: bold;
        }

        .category:hover {
            background-color: #e3eaff;
        }

        .course-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .course-card {
            background-color: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px #ddd;
            transition: transform 0.3s;
        }

        .course-card:hover {
            transform: translateY(-5px);
        }

        .course-image {
            width: 100%;
            height: 190px;
            object-fit: cover;
            display: block;
        }

        .course-content {
            padding: 20px;
        }

        .course-category {
            color: #5375d5;
            font-size: 14px;
            font-weight: bold;
        }

        .course-content h3 {
            margin: 10px 0;
            font-size: 21px;
        }

        .description {
            color: #666;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .instructor {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 15px 0;
        }

        .instructor img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .instructor p {
            font-size: 14px;
            color: #555;
        }

        .objectives {
            padding-left: 20px;
            margin: 15px 0;
            color: #444;
            line-height: 1.8;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .progress-bar {
            width: 100%;
            height: 10px;
            background-color: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .progress {
            height: 100%;
            background-color: #28a745;
            border-radius: 10px;
        }

        .enroll-btn {
            display: block;
            width: 100%;
            text-align: center;
            background-color: #253b80;
            color: white;
            padding: 12px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .enroll-btn:hover {
            background-color: #5375d5;
        }

        footer {
            background-color: #253b80;
            color: white;
            text-align: center;
            padding: 25px;
            margin-top: 50px;
        }

        @media (max-width: 900px) {
            .course-container {
                grid-template-columns: repeat(2, 1fr);
            }

            header {
                justify-content: center;
                text-align: center;
            }
        }

        @media (max-width: 600px) {
            .course-container {
                grid-template-columns: 1fr;
            }

            .hero h2 {
                font-size: 28px;
            }

            .container {
                width: 92%;
            }

            nav a {
                display: inline-block;
                margin: 7px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1> LearnHub</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#categories">Categories</a>
            <a href="#courses">Courses</a>
            <a href="#progress">My Progress</a>
        </nav>
    </header>

    <section class="hero" id="home">
        <h2>Learn New Skills Online</h2>
        <p>Discover courses, learn from experts, and build your future.</p>
        <a href="#courses">Explore Courses</a>
    </section>

    <main class="container">

        <section id="categories">
            <h2 class="section-title"> Course Categories</h2>

            <div class="categories">
                <div class="category"> Web Development</div>
                <div class="category"> Python Programming</div>
                <div class="category"> Artificial Intelligence</div>
                <div class="category"> Data Science</div>
            </div>
        </section>

        <section id="courses">
            <h2 class="section-title"> Popular Courses</h2>

            <div class="course-container">

                <article class="course-card">

                    <img class="course-image"
                         src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80"
                         alt="Web development workspace">

                    <div class="course-content">

                        <span class="course-category">WEB DEVELOPMENT</span>

                        <h3>HTML and CSS for Beginners</h3>

                        <p class="description">
                            Learn to create attractive and responsive websites
                            using HTML and CSS from the basics.
                        </p>

                        <div class="instructor">
                            <img src="https://i.pravatar.cc/100?img=12"
                                 alt="Instructor profile">
                            <div>
                                <strong>Rahul Sharma</strong>
                                <p>Web Development Instructor</p>
                            </div>
                        </div>

                        <h4>Learning Objectives</h4>

                        <ul class="objectives">
                            <li>Understand HTML structure</li>
                            <li>Learn CSS styling</li>
                            <li>Create responsive websites</li>
                        </ul>

                        <div id="progress">
                            <div class="progress-label">
                                <span>Your Progress</span>
                                <span>60%</span>
                            </div>

                            <div class="progress-bar">
                                <div class="progress" style="width: 60%;"></div>
                            </div>
                        </div>

                        <a href="#courses" class="enroll-btn">
                            Enroll Now
                        </a>

                    </div>
                </article>

                <article class="course-card">

                    <img class="course-image"
                         src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=800&q=80"
                         alt="Python programming on a computer">

                    <div class="course-content">

                        <span class="course-category">PROGRAMMING</span>

                        <h3>Python Programming</h3>

                        <p class="description">
                            Start programming with Python and learn variables,
                            conditions, loops, functions, and lists.
                        </p>

                        <div class="instructor">
                            <img src="https://i.pravatar.cc/100?img=11"
                                 alt="Instructor profile">
                            <div>
                                <strong>Priya Reddy</strong>
                                <p>Python Programming Instructor</p>
                            </div>
                        </div>

                        <h4>Learning Objectives</h4>

                        <ul class="objectives">
                            <li>Understand Python basics</li>
                            <li>Practice loops and conditions</li>
                            <li>Write simple Python programs</li>
                        </ul>

                        <div class="progress-label">
                            <span>Your Progress</span>
                            <span>35%</span>
                        </div>

                        <div class="progress-bar">
                            <div class="progress" style="width: 35%;"></div>
                        </div>

                        <a href="#courses" class="enroll-btn">
                            Enroll Now
                        </a>

                    </div>
                </article>

                <article class="course-card">

                    <img class="course-image"
                         src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=800&q=80"
                         alt="Artificial intelligence concept">

                    <div class="course-content">

                        <span class="course-category">ARTIFICIAL INTELLIGENCE</span>

                        <h3>Introduction to AI</h3>

                        <p class="description">
                            Explore artificial intelligence, machine learning,
                            neural networks, and real-world AI applications.
                        </p>

                        <div class="instructor">
                            <img src="https://i.pravatar.cc/100?img=47"
                                 alt="Instructor profile">
                            <div>
                                <strong>Ananya Kumar</strong>
                                <p>AI and Machine Learning Instructor</p>
                            </div>
                        </div>

                        <h4>Learning Objectives</h4>

                        <ul class="objectives">
                            <li>Understand AI concepts</li>
                            <li>Explore machine learning</li>
                            <li>Identify AI applications</li>
                        </ul>

                        <div class="progress-label">
                            <span>Your Progress</span>
                            <span>20%</span>
                        </div>

                        <div class="progress-bar">
                            <div class="progress" style="width: 20%;"></div>
                        </div>

                        <a href="#courses" class="enroll-btn">
                            Enroll Now
                        </a>

                    </div>
                </article>

            </div>
        </section>

    </main>

    <footer>
        <h3>🎓 LearnHub Online Learning Platform</h3>
        <p>Learn Today, Lead Tomorrow!</p>
        <p>&copy; 2026 LearnHub. All Rights Reserved.</p>
    </footer>

</body>
</html>
