<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub Online Learning Platform</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f3f6fb;
            color: #192b5c;
        }

        header {
            background-color: #192957;
            color: white;
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .logo span {
            color: #00aaff;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
            font-size: 14px;
        }

        nav a:hover {
            color: #ffcc00;
        }

        .hero {
            background: linear-gradient(to right, #192957, #2864ed);
            color: white;
            text-align: center;
            padding: 70px 20px;
        }

        .hero h1 {
            font-size: 34px;
            margin-bottom: 20px;
        }

        .hero p {
            margin-bottom: 25px;
        }

        .hero button {
            background-color: #ffcc00;
            border: none;
            padding: 13px 25px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        section {
            padding: 45px 8%;
        }

        .section-title {
            text-align: center;
            font-size: 26px;
            margin-bottom: 35px;
        }

        .category-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .category {
            background-color: white;
            padding: 30px 15px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 3px 8px #dce1e8;
        }

        .category-icon {
            font-size: 25px;
            color: #2864ed;
            margin-bottom: 12px;
            font-weight: bold;
        }

        .category h3 {
            color: #2864ed;
            margin-bottom: 8px;
        }

        .category p {
            color: #555;
            font-size: 14px;
        }

        .course-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .course-card {
            background-color: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 8px #dce1e8;
        }

        .course-image {
            height: 150px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 40px;
            font-weight: bold;
        }

        .image-one {
            background: linear-gradient(135deg, #ff7214, #e92c20);
        }

        .image-two {
            background: linear-gradient(135deg, #2864ed, #087c70);
        }

        .image-three {
            background: linear-gradient(135deg, #8838ed, #d51d80);
        }

        .image-four {
            background: linear-gradient(135deg, #0796b5, #4c43e8);
        }

        .course-info {
            padding: 18px;
        }

        .tag {
            background-color: #e0ebff;
            color: #2864ed;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 11px;
        }

        .course-info h3 {
            margin: 15px 0;
            font-size: 17px;
        }

        .course-info p {
            color: #444;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .rating {
            color: #f5a900;
            margin: 10px 0;
        }

        .enroll {
            width: 100%;
            padding: 12px;
            background-color: #2864ed;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .enroll:hover {
            background-color: #192957;
        }

        .objectives {
            background-color: #eaf2ff;
        }

        .objective-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .objective-card {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
        }

        .objective-card h3 {
            color: #2864ed;
            margin-bottom: 15px;
        }

        .objective-card ul {
            padding-left: 20px;
            color: #444;
            line-height: 1.8;
        }

        .instructor-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .instructor-card {
            background-color: white;
            text-align: center;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #dce1e8;
        }

        .instructor-image {
            width: 75px;
            height: 75px;
            margin: auto auto 15px;
            background-color: #dceaff;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #2864ed;
            font-size: 25px;
            font-weight: bold;
        }

        .instructor-card h3 {
            margin-bottom: 8px;
        }

        .instructor-card p {
            color: #555;
            font-size: 14px;
            line-height: 1.6;
        }

        .progress-section {
            background-color: white;
        }

        .progress-container {
            max-width: 650px;
            margin: auto;
        }

        .progress-card {
            background-color: #f3f6fb;
            padding: 22px;
            margin-bottom: 18px;
            border-radius: 10px;
        }

        .progress-card h3 {
            margin-bottom: 15px;
        }

        .progress-bar {
            width: 100%;
            height: 12px;
            background-color: #d1d5db;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .progress {
            height: 100%;
            background-color: #20c65a;
            border-radius: 10px;
        }

        .progress-card p {
            color: #444;
            font-size: 14px;
        }

        .contact {
            background-color: #eaf2ff;
            text-align: center;
        }

        .contact p {
            color: #444;
            margin: 12px 0;
        }

        footer {
            background-color: #192957;
            color: white;
            text-align: center;
            padding: 22px;
            line-height: 1.8;
        }

        @media (max-width: 900px) {
            .category-container,
            .course-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .objective-container,
            .instructor-container {
                grid-template-columns: repeat(2, 1fr);
            }

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 5px;
            }
        }

        @media (max-width: 600px) {
            .category-container,
            .course-container,
            .objective-container,
            .instructor-container {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 26px;
            }

            nav {
                text-align: center;
                line-height: 2;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">▣ Learn<span>Hub</span></div>

        <nav>
            <a href="#home">Home</a>
            <a href="#categories">Categories</a>
            <a href="#courses">Courses</a>
            <a href="#instructors">Instructors</a>
            <a href="#learning">My Learning</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <div class="hero" id="home">
        <h1>Learn New Skills Online</h1>
        <p>Explore expert-led courses and build your future from anywhere.</p>
        <button onclick="location.href='#courses'">Explore Courses</button>
    </div>

    <section id="categories">
        <h2 class="section-title">Course Categories</h2>

        <div class="category-container">

            <div class="category">
                <div class="category-icon">PC</div>
                <h3>Programming</h3>
                <p>Learn coding skills</p>
            </div>

            <div class="category">
                <div class="category-icon">AI</div>
                <h3>Artificial Intelligence</h3>
                <p>Explore AI technology</p>
            </div>

            <div class="category">
                <div class="category-icon">WD</div>
                <h3>Web Design</h3>
                <p>Create beautiful websites</p>
            </div>

            <div class="category">
                <div class="category-icon">DS</div>
                <h3>Data Science</h3>
                <p>Understand data</p>
            </div>

        </div>
    </section>

    <section id="courses">
        <h2 class="section-title">Popular Courses</h2>

        <div class="course-container">

            <div class="course-card">
                <div class="course-image image-one">WEB</div>
                <div class="course-info">
                    <span class="tag">Web Development</span>
                    <h3>HTML and CSS Basics</h3>
                    <p>Learn to create attractive and responsive websites from scratch.</p>
                    <p>Instructor: Rahul Sharma</p>
                    <div class="rating">★★★★★ (4.9)</div>
                    <p><b>Duration:</b> 6 hours</p>
                    <button class="enroll">Enroll Now</button>
                </div>
            </div>

            <div class="course-card">
                <div class="course-image image-two">PY</div>
                <div class="course-info">
                    <span class="tag">Programming</span>
                    <h3>Python for Beginners</h3>
                    <p>Understand variables, conditions, loops, functions, and lists.</p>
                    <p>Instructor: Priya Reddy</p>
                    <div class="rating">★★★★★ (4.8)</div>
                    <p><b>Duration:</b> 8 hours</p>
                    <button class="enroll">Enroll Now</button>
                </div>
            </div>

            <div class="course-card">
                <div class="course-image image-three">AI</div>
                <div class="course-info">
                    <span class="tag">Artificial Intelligence</span>
                    <h3>Introduction to AI</h3>
                    <p>Discover AI concepts, applications, and modern AI tools.</p>
                    <p>Instructor: Arjun Kumar</p>
                    <div class="rating">★★★★★ (4.7)</div>
                    <p><b>Duration:</b> 5 hours</p>
                    <button class="enroll">Enroll Now</button>
                </div>
            </div>

            <div class="course-card">
                <div class="course-image image-four">UI</div>
                <div class="course-info">
                    <span class="tag">Design</span>
                    <h3>UI and Web Design</h3>
                    <p>Learn layouts, colors, spacing, and user-friendly design.</p>
                    <p>Instructor: Sneha Patel</p>
                    <div class="rating">★★★★★ (4.6)</div>
                    <p><b>Duration:</b> 7 hours</p>
                    <button class="enroll">Enroll Now</button>
                </div>
            </div>

        </div>
    </section>

    <section class="objectives">
        <h2 class="section-title">Learning Objectives</h2>

        <div class="objective-container">

            <div class="objective-card">
                <h3>Programming</h3>
                <ul>
                    <li>Understand programming basics</li>
                    <li>Write simple programs</li>
                    <li>Develop problem-solving skills</li>
                </ul>
            </div>

            <div class="objective-card">
                <h3>Web Development</h3>
                <ul>
                    <li>Understand HTML structure</li>
                    <li>Style pages using CSS</li>
                    <li>Build responsive websites</li>
                </ul>
            </div>

            <div class="objective-card">
                <h3>Artificial Intelligence</h3>
                <ul>
                    <li>Understand basic AI concepts</li>
                    <li>Explore AI applications</li>
                    <li>Use AI learning tools</li>
                </ul>
            </div>

        </div>
    </section>

    <section id="instructors">
        <h2 class="section-title">Meet Our Instructors</h2>

        <div class="instructor-container">

            <div class="instructor-card">
                <div class="instructor-image">RS</div>
                <h3>Rahul Sharma</h3>
                <p>Web Development Expert</p>
                <p>5+ Years of Experience</p>
            </div>

            <div class="instructor-card">
                <div class="instructor-image">PR</div>
                <h3>Priya Reddy</h3>
                <p>Python Instructor</p>
                <p>4+ Years of Experience</p>
            </div>

            <div class="instructor-card">
                <div class="instructor-image">AK</div>
                <h3>Arjun Kumar</h3>
                <p>AI Specialist</p>
                <p>6+ Years of Experience</p>
            </div>

        </div>
    </section>

    <section class="progress-section" id="learning">
        <h2 class="section-title">My Learning Progress</h2>

        <div class="progress-container">

            <div class="progress-card">
                <h3>HTML and CSS Basics</h3>
                <div class="progress-bar">
                    <div class="progress" style="width: 80%;"></div>
                </div>
                <p>80% Completed</p>
            </div>

            <div class="progress-card">
                <h3>Python for Beginners</h3>
                <div class="progress-bar">
                    <div class="progress" style="width: 60%;"></div>
                </div>
                <p>60% Completed</p>
            </div>

            <div class="progress-card">
                <h3>Introduction to AI</h3>
                <div class="progress-bar">
                    <div class="progress" style="width: 35%;"></div>
                </div>
                <p>35% Completed</p>
            </div>

        </div>
    </section>

    <section class="contact" id="contact">
        <h2 class="section-title">Contact Us</h2>

        <p><b>Email:</b> support@learnhub.example</p>
        <p><b>Phone:</b> +91 98765 43210</p>
        <p><b>Address:</b> Vijayawada, Andhra Pradesh, India</p>
        <p>Start learning today and develop your skills for tomorrow!</p>
    </section>

    <footer>
        <p>© 2026 LearnHub Online Learning Platform</p>
        <p>Designed using HTML and CSS only.</p>
    </footer>

</body>
</html>
